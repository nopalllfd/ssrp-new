# =============================================================
# Environment variables — Yurchat client
# Salin ke .env lalu isi nilainya.
# =============================================================

# --- Frontend (boleh ter-expose ke browser, prefix VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only: AI Chatlog Tools (provider kompatibel OpenAI) ---
# Dibaca oleh serverless function api/ai-chatlog.ts (Vercel) dan oleh
# middleware dev di vite.config.ts (npm run dev lokal).
# Di Vercel: Project Settings → Environment Variables.
# JANGAN pernah memakai prefix VITE_ untuk variabel-variabel ini
# agar API key tidak masuk ke bundle frontend.
OPENAI_API_KEY=
# Opsional. Base URL provider kompatibel OpenAI (OpenAI SDK: baseURL).
# Jika kosong, default ke https://ai.sumopod.com/v1 (SumoPod).
OPENAI_BASE_URL=
# Opsional. Model yang dipakai untuk klasifikasi chatlog.
# Harus model yang masih didukung dan cocok untuk text classification.
# Contoh: gpt-4o-mini. Jika kosong, default ke gpt-4o-mini.
OPENAI_MODEL=
